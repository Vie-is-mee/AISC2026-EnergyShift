# Render Web Service > Environment. Exact frontend origin, no trailing path.
# Leave empty when using only the Render-hosted UI. Multiple origins: comma-separated.
ENERGYSHIFT_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app
# RENDER_EXTERNAL_HOSTNAME and RENDER_GIT_COMMIT are provided by Render automatically.
# Engine works without a model key. Optional AI intake needs these backend-only values:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
ENERGYSHIFT_TEAM_DEMO_ENABLED=1
# Ephemeral on Render Free; export important reports before redeploy.
ENERGYSHIFT_TEAM_DB=/tmp/energyshift-team-demo.sqlite3
